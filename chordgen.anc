; chordgen.anc - Generate Chords

(include <portmidi.h>)
(include <porttime.h>)
(include <stdio.h>)
(include <time.h>)
(include <windows.h>)
(include <io.h>)
(include <stdlib.h>)
(ffi fgets (char* int void*) -> char*)
(ffi printf (const char* ...) -> int)
(ffi sprintf (char* const char* ...) -> int)
(ffi rand   () -> int)
(ffi srand  (unsigned int) -> void)
(ffi time   (void*) -> long)
(ffi Pm_Initialize () -> int)
(ffi Pm_CountDevices () -> int)
(ffi Pm_GetDeviceInfo (int) -> (const void*))
(ffi Pm_OpenInput (void* int int int void*) -> int)
(ffi Pm_Poll (void* void*) -> int)
(ffi Pm_Read (void* void* int) -> int)
(ffi Pt_Sleep (int) -> void)
(ffi SetConsoleOutputCP (unsigned int) -> int)
(ffi _fileno (void*) -> int)
(ffi _setmode (int int) -> int)
(ffi strcmp (const char* const char*) -> int)
(ffi atoi (const char*) -> int)

(define-syntax for
  (syntax-rules (to)
    [(_ var from to limit body ...)
     (block
       (let var from)
       (while (< var limit)
         body ...
         (set! var (+ var 1))))]))

(define-syntax let-chords
    (macro-case ()
      [(_ name chords ...)
       `(do
         (let ,name (alloc ,(* 8 (length chords))))
         ,@(let loop ([offset 0] [rest chords])
            (if (null? rest) '()
                (cons `(set! ,name ,offset ,(car rest))
                      (loop (+ offset 8) (cdr rest))))))]))

(fn gen-chord (chords num-chords inversions num-inversions result)
    (let chord-idx (% (rand) num-chords))
    (let chord (get chords (* chord-idx 8)))

    (let inversion-idx (% (rand) num-inversions))
    (let inversion (get inversions (* inversion-idx 16)))

    (sprintf result "%s %s" (cast char* chord) (cast char* inversion))
    (return result))

(fn copy-notes (src dst count)
    (for i 0 to count
        (set! dst (* i 8) (get src (* i 8))))
    (return 0))

(fn note-add (notes note-count note)
    (let count (get note-count 0))
    (for i 0 to count
        (if (== (get notes (* i 8)) note)
            (return 0)))
    (set! notes (* count 8) note)
    (set! note-count 0 (+ count 1))
    (return 0))

(fn note-remove (notes note-count note)
    (let count (get note-count 0))
    (for i 0 to count
        (if (== (get notes (* i 8)) note)
            (do
                (for j i to (- count 1)
                    (set! notes (* j 8) (get notes (* (+ j 1) 8))))
                (set! note-count 0 (- count 1))
                (return 0))))
    (return 0))

(fn print-notes (notes count)
    (printf "Notes (%d):" (cast int count))
    (for i 0 to count
        (printf " %d" (cast int (get notes (* i 8)))))
    (printf "\n")
    (return 0))

(fn identify-chord (notes count note-names result)
    (if (!= count 3)
        (return 0))

    ; Extract pitch classes
    (let p0 (% (get notes 0) 12))
    (let p1 (% (get notes 8) 12))
    (let p2 (% (get notes 16) 12))

    ; Sort 3 pitch classes (comparison network)
    (if (> p0 p1) (do (let t p0) (set! p0 p1) (set! p1 t)))
    (if (> p1 p2) (do (let t p1) (set! p1 p2) (set! p2 t)))
    (if (> p0 p1) (do (let t p0) (set! p0 p1) (set! p1 t)))

    ; Reject duplicate pitch classes (same note in multiple octaves)
    (if (|| (== p0 p1) (== p1 p2))
        (return 0))

    (let i1 (- p1 p0))
    (let i2 (- p2 p1))

    (let root-pc 0)
    (let chord-type-str 0)
    (let chord-type-id 0)  ; 1=maj, 2=min, 3=dim

    ; Major: i1,i2 = (4,3) (3,5) (5,4) — root is p0, p2, p1 respectively
    (if (&& (== i1 4) (== i2 3)) (do (set! root-pc p0) (set! chord-type-str "maj") (set! chord-type-id 1)))
    (if (&& (== i1 3) (== i2 5)) (do (set! root-pc p2) (set! chord-type-str "maj") (set! chord-type-id 1)))
    (if (&& (== i1 5) (== i2 4)) (do (set! root-pc p1) (set! chord-type-str "maj") (set! chord-type-id 1)))
    ; Minor: i1,i2 = (3,4) (4,5) (5,3)
    (if (&& (== i1 3) (== i2 4)) (do (set! root-pc p0) (set! chord-type-str "m")   (set! chord-type-id 2)))
    (if (&& (== i1 4) (== i2 5)) (do (set! root-pc p2) (set! chord-type-str "m")   (set! chord-type-id 2)))
    (if (&& (== i1 5) (== i2 3)) (do (set! root-pc p1) (set! chord-type-str "m")   (set! chord-type-id 2)))
    ; Diminished: i1,i2 = (3,3) (3,6) (6,3)
    (if (&& (== i1 3) (== i2 3)) (do (set! root-pc p0) (set! chord-type-str "dim") (set! chord-type-id 3)))
    (if (&& (== i1 3) (== i2 6)) (do (set! root-pc p2) (set! chord-type-str "dim") (set! chord-type-id 3)))
    (if (&& (== i1 6) (== i2 3)) (do (set! root-pc p1) (set! chord-type-str "dim") (set! chord-type-id 3)))

    (if (== chord-type-id 0)
        (return 0))

    ; Compute 3rd and 5th pitch classes from root
    (let third-interval (if (== chord-type-id 1) 4 3))  ; maj=4, min/dim=3
    (let fifth-interval  (if (== chord-type-id 3) 6 7))  ; dim=6, maj/min=7
    (let third-pc (% (+ root-pc third-interval) 12))
    (let fifth-pc  (% (+ root-pc fifth-interval)  12))

    ; Find lowest physical note
    (let lowest (get notes 0))
    (for k 1 to count
        (if (< (get notes (* k 8)) lowest)
            (set! lowest (get notes (* k 8)))))
    (let lowest-pc (% lowest 12))

    ; Determine inversion from lowest note's pitch class
    (let inversion "root")
    (if (== lowest-pc third-pc) (set! inversion "1st inversion"))
    (if (== lowest-pc fifth-pc) (set! inversion "2nd inversion"))

    (let root-name (get note-names (* root-pc 8)))
    (sprintf result "%s%s %s" (cast char* root-name) (cast char* chord-type-str) (cast char* inversion))
    (return result))

(fn find-midi-input-device (select)
    (if (! select)
        (do
            (for i 0 to (Pm_CountDevices)
                (let info (Pm_GetDeviceInfo (cast int i)))
                (let is-output (get info 28 4))
                (if (== is-output 0)
                    (return i)))
            (return -1)))
    (with-arena
        (printf "MIDI input devices:\n")
        (for i 0 to (Pm_CountDevices)
            (let info (Pm_GetDeviceInfo (cast int i)))
            (let name (cast char* (get info 16)))
            (let is-output (get info 28 4))
            (if (== is-output 0)
                (printf "  %d: \x1b[96m%s\x1b[0m\n" (cast int i) (cast char* name))))
        (printf "Enter device ID: ")
        (let buf (alloc 16))
        (fgets (cast char* buf) 16 (c-const stdin))
        (return (atoi (cast char* buf)))))

(fn read-chord (midi buf active-notes note-count last-notes last-count debug)
    (let started 0)
    (while 1
        (if (== (Pm_Poll (get midi 0)) 1)
            (do
                (let count (Pm_Read (get midi 0) buf 32))
                (for i 0 to count
                    (let message (get buf (* i 8) 4))
                    (let status (band message 0xFF))
                    (let note (band (rshift message 8) 0xFF))
                    (let velocity (band (rshift message 16) 0xFF))
                    (if (&& (== status 0x90) (!= velocity 0))
                        (do
                            (note-add active-notes note-count note)
                            (set! started 1)
                            (let nc (get note-count 0))
                            (copy-notes active-notes last-notes nc)
                            (set! last-count 0 nc)
                            (if debug (print-notes active-notes nc))))
                    (if (|| (== status 0x80) (&& (== status 0x90) (== velocity 0)))
                        (do
                            (note-remove active-notes note-count note)
                            (if debug (print-notes active-notes (get note-count 0)))
                            (if (&& started (== (get note-count 0) 0))
                                (return 0)))))))
        (Pt_Sleep 10)))

(fn main (argc argv)
    (with-arena
        (SetConsoleOutputCP 65001)
        (_setmode (_fileno (c-const stdout)) 0x8000)

        (let debug 0)
        (let select-device 0)
        (let help 0)
        (for i 1 to argc
            (let arg (get argv (* i 8)))
            (if (|| (== (strcmp (cast char* arg) "-d") 0)
                    (== (strcmp (cast char* arg) "--debug") 0))
                (set! debug 1))
            (if (|| (== (strcmp (cast char* arg) "-s") 0)
                    (== (strcmp (cast char* arg) "--select-device") 0))
                (set! select-device 1))
            (if (|| (== (strcmp (cast char* arg) "-h") 0)
                    (== (strcmp (cast char* arg) "--help") 0))
                (set! help 1)))

        (if help
            (do
                (printf "Usage: chordgen [options]\n\n")
                (printf "MIDI chord trainer. Displays a random chord and waits for you to play it.\n\n")
                (printf "Options:\n")
                (printf "  -s, --select-device   List MIDI input devices and choose one interactively\n")
                (printf "  -d, --debug           Print raw MIDI note numbers on each key event\n")
                (printf "  -h, --help            Show this help message\n")
                (return 0)))

        (let-chords note-names "C" "C♯" "D" "E♭" "E" "F" "F♯" "G" "A♭" "A" "B♭" "B")

        ; Store chord names as pointers in an 8-byte-per-slot chords array
        (let num-chords 18)
        (let-chords chords "Cmaj" "Cm" "Dmaj" "Dm" "E♭maj" "Em" "Edim" "Fmaj" "F♯maj" "Gmaj" "Gm" "Amaj" "Am" "Adim" "B♭maj" "Bm" "Bdim" "C♯m")

        (let num-inversions 3)
        (let inversions (alloc (* 3 16)))
        (set! inversions 0 "root")
        (set! inversions 16 "1st inversion")
        (set! inversions 32 "2nd inversion")

        (let input-buffer-size 128)
        (let midi (alloc 8))
        (let event (alloc 256))
        (let active-notes (alloc (* 16 8)))
        (let note-count (alloc 8))
        (set! note-count 0 0)
        (let last-notes (alloc (* 16 8)))
        (let last-count (alloc 8))
        (set! last-count 0 0)

        ; Seed random number generator
        (srand (time 0))

        (if (!= (Pm_Initialize) 0)
            (do
                (printf "Failed to initialize PortMidi\n")
                (return 1)))

        (let device-id (find-midi-input-device select-device))
        (if (== device-id -1)
            (do
                (printf "No MIDI input device found\n")
                (return 1)))

        (if (!= (Pm_OpenInput midi device-id 0 input-buffer-size 0 0) 0)
            (do
                (printf "Failed to open MIDI input\n")
                (return 1)))

        (while 1
            (with-arena-checkpoint
                (let result (alloc 32))
                (printf "\nPlay this chord: \x1b[96m%s\x1b[0m\n\n"
                    (cast char* (gen-chord chords num-chords inversions num-inversions result)))

                (let correct 0)
                (while (== correct 0)
                    (with-arena-checkpoint
                        (set! note-count 0 0)
                        (set! last-count 0 0)
                        (read-chord midi event active-notes note-count last-notes last-count debug)

                        (let id-result (alloc 32))
                        (let identified (identify-chord last-notes (get last-count 0) note-names id-result))
                        (if (&& identified (== (strcmp (cast char* identified) (cast char* result)) 0))
                            (do
                                (printf "\x1b[92mCorrect!\x1b[0m\n")
                                (set! correct 1))
                            (do
                                (if identified
                                    (printf "That's \x1b[91m%s\x1b[0m, try again\n" (cast char* identified))
                                    (printf "\x1b[93mUnknown chord\x1b[0m, try again\n"))))))))))
