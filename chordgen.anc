; chordgen.anc - MIDI chord trainer

(include <stdio.h>)
(include <time.h>)
(include <windows.h>)
(include <io.h>)
(include <stdlib.h>)

(ffi fgets   (char* int void*) -> char*)
(ffi printf  (const char* ...) -> int)
(ffi sprintf (char* const char* ...) -> int)
(ffi rand    () -> int)
(ffi srand   (unsigned int) -> void)
(ffi time    (void*) -> long)
(ffi SetConsoleOutputCP (unsigned int) -> int)
(ffi _fileno (void*) -> int)
(ffi _setmode (int int) -> int)
(ffi strcmp  (const char* const char*) -> int)
(ffi atoi    (const char*) -> int)
(ffi strtol  (const char* void* int) -> long)

(define-syntax for
  (syntax-rules (to)
    [(_ var from to limit body ...)
     (block
       (let var from)
       (while (< var limit)
         body ...
         (set! var (+ var 1))))]))

(define-syntax parse-arg
    (syntax-rules ()
        [(_ argc argv args var short long)
         (block
            (set! args Args var 0)
            (for i 1 to argc
                (let arg (get argv (* i 8)))
                (if (|| (== (strcmp (cast char* arg) short) 0)
                        (== (strcmp (cast char* arg) long) 0))
                    (set! args Args var 1))))]))

(include "midi.anc")
(include "chords.anc")
(include "lessons.anc")

; ---- note names (shared by chords.anc functions and main) ----

(define-syntax let-note-names
    (macro-case ()
      [(_ var)
       `(do
          (let ,var (alloc (* 12 8)))
          (set! ,var  0  "C")
          (set! ,var  8  "C♯")
          (set! ,var 16  "D")
          (set! ,var 24  "E♭")
          (set! ,var 32  "E")
          (set! ,var 40  "F")
          (set! ,var 48  "F♯")
          (set! ,var 56  "G")
          (set! ,var 64  "A♭")
          (set! ,var 72  "A")
          (set! ,var 80  "B♭")
          (set! ,var 88  "B"))]))

; ---- CLI arg handling ----

(struct Args (debug 8) (select-device 8) (lesson-num 8) (list-lessons 8) (help 8))

(fn parse-args (argc argv)
    (let a (alloc (sizeof Args)))
    (set! a Args debug 0)
    (set! a Args select-device 0)
    (set! a Args lesson-num -1)
    (set! a Args list-lessons 0)
    (set! a Args help 0)
    (for i 1 to argc
        (let arg (cast char* (get argv (* i 8))))
        (if (|| (== (strcmp arg "-d") 0) (== (strcmp arg "--debug") 0))
            (set! a Args debug 1))
        (if (|| (== (strcmp arg "-s") 0) (== (strcmp arg "--select-device") 0))
            (set! a Args select-device 1))
        (if (|| (== (strcmp arg "-l") 0) (== (strcmp arg "--list") 0))
            (set! a Args list-lessons 1))
        (if (|| (== (strcmp arg "-h") 0) (== (strcmp arg "--help") 0))
            (set! a Args help 1))
        (if (== (strcmp arg "--lesson") 0)
            (if (< i (- argc 1))
                (do
                    (set! i (+ i 1))
                    (set! a Args lesson-num (atoi (cast char* (get argv (* i 8)))))))))
    (return a))

(fn print-help ()
    (printf "Usage: chordgen [options]\n\n")
    (printf "MIDI chord trainer with structured lessons.\n\n")
    (printf "Options:\n")
    (printf "  -l, --list             List all available lessons\n")
    (printf "      --lesson N         Start lesson number N directly\n")
    (printf "  -s, --select-device    List MIDI input devices and choose one interactively\n")
    (printf "  -d, --debug            Print raw MIDI note numbers on each key event\n")
    (printf "  -h, --help             Show this help message\n")
    (return 0))

(fn print-lesson-list (lessons num-lessons)
    (printf "\nAvailable lessons:\n\n")
    (for i 0 to num-lessons
        (let les (+ lessons (* i 24)))
        (let name (get les Lesson name))
        (let n-ex (get les Lesson num-exercises))
        (printf "  \x1b[93m%d\x1b[0m. \x1b[96m%s\x1b[0m" (cast int (+ i 1)) (cast char* name))
        (printf "  (%d exercise%s)\n" (cast int n-ex) (cast char* (if (== n-ex 1) "" "s"))))
    (printf "\n")
    (return 0))

(fn select-lesson-menu (lessons num-lessons)
    (with-arena
        (print-lesson-list lessons num-lessons)
        (printf "Enter lesson number: ")
        (let buf (alloc 16))
        (fgets (cast char* buf) 16 (c-const stdin))
        (let n (- (atoi (cast char* buf)) 1))
        (if (|| (< n 0) (>= n num-lessons))
            (do
                (printf "Invalid selection, defaulting to lesson 1\n")
                (return 0)))
        (return n)))

; ---- exercise display ----

(fn print-progression-line (prog prog-len note-names key-id chord-bufs)
    (printf "  Chords:")
    (for i 0 to prog-len
        (let degree (get prog (* i 8)))
        (printf " \x1b[93m%s\x1b[0m: \x1b[96m%s\x1b[0m"
            (cast char* (degree-roman degree))
            (cast char* (get chord-bufs (* i 8))))
        (if (< i (- prog-len 1)) (printf "  ")))
    (printf "\n")
    (return 0))

; ---- game loop ----

; Run one chord challenge: prompt, read player input, identify, return 1 on correct.
(fn challenge (degree target midi event active-notes note-count last-notes last-count note-names debug)
    (printf "Play \x1b[93m%s\x1b[0m: \x1b[96m%s\x1b[0m\n"
        (cast char* (degree-roman degree))
        (cast char* target))

    (set! note-count 0 0)
    (set! last-count 0 0)
    (read-chord midi event active-notes note-count last-notes last-count debug)

    (let id-buf (alloc 32))
    (let identified (identify-chord last-notes (get last-count 0) note-names id-buf))
    (if (&& identified (== (strcmp (cast char* identified) (cast char* target)) 0))
        (do
            (printf "\x1b[92mCorrect!\x1b[0m\n")
            (return 1)))
    (if identified
        (printf "That's \x1b[91m%s\x1b[0m, try again\n" (cast char* identified))
        (printf "\x1b[93mUnknown chord\x1b[0m, try again\n"))
    (return 0))

(fn run-exercise (ex midi event active-notes note-count last-notes last-count note-names debug)
    (let num-keys (get ex Exercise num-keys))
    (let keys     (get ex Exercise keys))
    (let prog-len (get ex Exercise prog-len))
    (let prog     (get ex Exercise progression))
    (let reps     (get ex Exercise reps))
    (let random-mode (== prog-len 0))

    ; Pick key once for the whole exercise
    (let key-idx (% (rand) num-keys))
    (let key-id  (get keys (* key-idx 8)))

    (let key-buf (alloc 32))
    (key-name key-id note-names key-buf)

    (if random-mode
        ; --- Random chord mode ---
        (do
            (printf "\nKey: \x1b[96m%s\x1b[0m  |  \x1b[93mRandom chords\x1b[0m\n\n"
                (cast char* key-buf))
            (let rounds-done 0)
            (while (|| (== reps -1) (< rounds-done reps))
                (with-arena-checkpoint
                    (let degree (+ 1 (% (rand) 7)))
                    (let inv    (% (rand) 3))
                    (let target (alloc 32))
                    (chord-name-for-degree key-id degree inv note-names target)
                    ; Retry same chord until correct, then advance round counter.
                    (let done 0)
                    (while (! done)
                        (if (challenge degree target midi event active-notes note-count
                                       last-notes last-count note-names debug)
                            (set! done 1)))
                    (if (!= reps -1) (set! rounds-done (+ rounds-done 1))))))
        ; --- Progression mode ---
        (do
            (let inv-buf (alloc (* prog-len 8)))
            (for i 0 to prog-len
                (set! inv-buf (* i 8) (% (rand) 3)))

            (let chord-bufs (alloc (* prog-len 8)))
            (for i 0 to prog-len
                (let cstr (alloc 32))
                (chord-name-for-degree key-id (get prog (* i 8)) (get inv-buf (* i 8)) note-names cstr)
                (set! chord-bufs (* i 8) cstr))

            (printf "\nKey: \x1b[96m%s\x1b[0m  |  " (cast char* key-buf))
            (for i 0 to prog-len
                (printf "\x1b[93m%s\x1b[0m" (cast char* (degree-roman (get prog (* i 8)))))
                (if (< i (- prog-len 1)) (printf " - ")))
            (printf "\n")
            (print-progression-line prog prog-len note-names key-id chord-bufs)
            (printf "\n")

            (let rounds-done 0)
            (while (|| (== reps -1) (< rounds-done reps))
                (let chord-idx 0)
                (while (< chord-idx prog-len)
                    (with-arena-checkpoint
                        (let degree (get prog (* chord-idx 8)))
                        (let target (get chord-bufs (* chord-idx 8)))
                        (if (challenge degree target midi event active-notes note-count
                                       last-notes last-count note-names debug)
                            (set! chord-idx (+ chord-idx 1)))))

                (if (!= reps -1)
                    (set! rounds-done (+ rounds-done 1))))))
    (return 0))

(fn run-lesson (lesson midi event active-notes note-count last-notes last-count note-names debug)
    (let n-ex  (get lesson Lesson num-exercises))
    (let exptrs (get lesson Lesson exercises))
    (let ex-idx 0)
    (while 1
        (let ex (get exptrs (* ex-idx 8)))
        (run-exercise ex midi event active-notes note-count last-notes last-count note-names debug)
        (set! ex-idx (% (+ ex-idx 1) n-ex))
        (if (== ex-idx 0)
            (printf "\n\x1b[92mLesson complete! Starting over...\x1b[0m\n")
            (printf "\n\x1b[92mExercise complete! Next exercise...\x1b[0m\n")))
    (return 0))

(fn main (argc argv)
    (with-arena
        (SetConsoleOutputCP 65001)
        (_setmode (_fileno (c-const stdout)) 0x8000)

        (let args (parse-args argc argv))
        (let debug         (get args Args debug))
        (let select-device (get args Args select-device))
        (let lesson-num    (get args Args lesson-num))
        (let list-lessons  (get args Args list-lessons))
        (let help          (get args Args help))

        (if help (do (print-help) (return 0)))

        (let-note-names note-names)

        (define-lessons all-lessons num-all-lessons
            (lesson "C major Triads"
                (exercise (keys C-major)
                          (random)
                          (reps -1)))
            (lesson "D major Triads"
                (exercise (keys D-major)
                          (random)
                          (reps -1)))
            (lesson "F major Triads"
                (exercise (keys F-major)
                          (random)
                          (reps -1)))
            (lesson "B♭ major Triads"
                (exercise (keys Bb-major)
                          (random)
                          (reps -1)))
            (lesson "I - V - VI - IV (C, D, F, B♭)"
                (exercise (keys C-major D-major F-major Bb-major)
                          (progression 1 5 6 4)
                          (reps 10))))

        (if list-lessons
            (do
                (print-lesson-list all-lessons num-all-lessons)
                (return 0)))

        (let input-buffer-size 128)
        (let midi       (alloc 8))
        (let event      (alloc 256))
        (let active-notes (alloc (* 16 8)))
        (let note-count (alloc 8))
        (set! note-count 0 0)
        (let last-notes (alloc (* 16 8)))
        (let last-count (alloc 8))
        (set! last-count 0 0)

        (srand (time 0))

        (if (!= (Pm_Initialize) 0)
            (do
                (printf "Failed to initialize PortMidi\n")
                (return 1)))

        (let device-id (find-midi-input-device select-device))
        (if (== device-id -1)
            (do
                (printf "No MIDI input device found\n")
                (return 1)))

        (if (!= (Pm_OpenInput midi device-id 0 input-buffer-size 0 0) 0)
            (do
                (printf "Failed to open MIDI input\n")
                (return 1)))

        (let chosen-idx
            (if (!= lesson-num -1)
                (do
                    (if (|| (< lesson-num 1) (> lesson-num num-all-lessons))
                        (do
                            (printf "Lesson %d does not exist\n" (cast int lesson-num))
                            (return 1)))
                    (- lesson-num 1))
                (select-lesson-menu all-lessons num-all-lessons)))

        (let chosen-lesson (+ all-lessons (* chosen-idx 24)))
        (let lesson-name (get chosen-lesson Lesson name))
        (printf "\n\x1b[96mStarting: %s\x1b[0m\n" (cast char* lesson-name))

        (run-lesson chosen-lesson midi event active-notes note-count last-notes last-count note-names debug)))
